# Copy this file to .env.local and paste your own key.
# Get a free key at https://aistudio.google.com/apikey
#
# NOTE: Prahari runs its detection engine fully offline. The Gemini key only
# powers the natural-language explanation layer (message scanner, AI
# Investigator, incident report). Without a key the app still works — it
# falls back to the on-device engine.

VITE_GEMINI_API_KEY=your_key_here
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
